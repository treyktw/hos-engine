{
  "name": "hos-engine",
  "version": "0.1.0",
  "description": "FMCSA hours-of-service engine in TypeScript: duty-status normalization, 11/14/8/70 clocks, split sleeper, short-haul exceptions, home-terminal time zones, and route HOS projection.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx examples/route-projection.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
